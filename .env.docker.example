# Settings for running the app in Docker. Placeholders only: never commit a filled-in copy.
# Same variables as .env.example, but Zetaris and Meterless Nightshift run on the host,
# so the container reaches them through host.docker.internal instead of localhost.
#   cp .env.docker.example .env.docker      (then fill in the two credentials)
#   docker run --rm -p 8000:8000 --env-file .env.docker exposureledger
# On Linux without Docker Desktop, also pass --add-host=host.docker.internal:host-gateway.

# Zetaris (data layer)
ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider; keep the Nightshift app open on the host)
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# Runtime
SAMPLE_MODE=false
PORT=8000
EL_PREFIX=EL_
INVENTORY_URL=https://raw.githubusercontent.com/berkinksk/exposureledger/main/data/inventory.json
