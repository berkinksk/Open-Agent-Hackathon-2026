# Settings for running the app directly on this machine. Placeholders only: never commit a filled-in copy.
#   cp .env.example .env      (then fill in the two credentials)
# The npm scripts load .env automatically (node --env-file-if-exists=.env).
# For Docker, use .env.docker.example instead (host.docker.internal URLs).

# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider; keep the Nightshift app open)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# Runtime
# SAMPLE_MODE=true runs offline: no Zetaris, no Nightshift, no network, deterministic logic on cached data.
SAMPLE_MODE=false
PORT=8000
# Prefix of every Zetaris object the app creates (databases EL_*, tables el_*). Must start with EL_ and end with _.
EL_PREFIX=EL_
# The synthetic inventory, read by Zetaris over GitHub raw.
INVENTORY_URL=https://raw.githubusercontent.com/berkinksk/exposureledger/main/data/inventory.json
